# =====================================================
# MINI STORE BACKEND - ENVIRONMENT
# =====================================================
# Copy to .env and fill in. Switch environments by changing APP_ENV only.
#
#   APP_ENV=development | preprod | production   (dev | prep | prod also work)
#
# Every setting below can be written:
#   - prefixed per environment: DEV_x, PREP_x, PROD_x
#   - or un-prefixed (x) as a shared default for all environments
# The prefixed value wins when both exist.

APP_ENV=development

# ---------------- Server ----------------
PORT=5000
HOST=0.0.0.0
# Serve HTTPS directly from Node (default true). Set false only if
# nginx proxies to http://127.0.0.1:PORT.
HTTPS_ENABLED=true
SSL_KEY_PATH=cert/server.key
SSL_CERT_PATH=cert/server.crt
# true when behind nginx/load balancer
TRUST_PROXY=false
PROD_TRUST_PROXY=true
PREP_TRUST_PROXY=true
REQUEST_LOGGING=false
DEV_REQUEST_LOGGING=true

# Comma separated list of frontend origins allowed by CORS
DEV_CORS_ORIGINS=https://localhost:3000,http://localhost:3000
PREP_CORS_ORIGINS=https://staging.example.com
PROD_CORS_ORIGINS=https://necbot.store

# ---------------- Database ----------------
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=3306
DEV_DB_NAME=minstore
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=
DEV_DB_DIALECT=mysql
DEV_DB_LOGGING=false

PREP_DB_HOST=
PREP_DB_PORT=3306
PREP_DB_NAME=
PREP_DB_USERNAME=
PREP_DB_PASSWORD=

PROD_DB_HOST=
PROD_DB_PORT=3306
PROD_DB_NAME=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=

# Existing data is stored in UTC. Leave as +00:00 unless the DB is new.
DB_TIMEZONE=+00:00
DB_POOL_MAX=10

# ---------------- Auth ----------------
# Required in preprod/production. Use long random strings, different per env:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DEV_ACCESSTOKEN_SECRETE=
DEV_REFRESHTOKEN_SECRETE=
DEV_RECOVERY_SECRETE=
PROD_ACCESSTOKEN_SECRETE=
PROD_REFRESHTOKEN_SECRETE=
PROD_RECOVERY_SECRETE=
PREP_ACCESSTOKEN_SECRETE=
PREP_REFRESHTOKEN_SECRETE=
PREP_RECOVERY_SECRETE=

ACCESS_TOKEN_TTL=300m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# Refresh-token cookie
DEV_COOKIE_SECURE=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------------- SaaS / subscriptions ----------------
# Allow anyone to create a new store from /auth/register
ALLOW_PUBLIC_SIGNUP=false
DEFAULT_PLAN_CODE=starter
TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=3
DEFAULT_CURRENCY=TZS

# Name given to the tenant that receives all pre-SaaS data during migration
DEFAULT_TENANT_NAME=Main Store
